,,,ORG 0000H
0000,01 30,,AJMP MAIN
,,,ORG 0030H
0030,,MAIN,MAIN:
0030,75 81 60,,        MOV SP,#60H
0033,75 80 FE,,        MOV P0,#0FEH
0036,75 20 FE,,        MOV 20H,#0FEH
,,,
0039,,MAIN_LOOP,MAIN_LOOP:
0039,85 20 80,,        MOV P0,20H
003C,12 00 46,,        LCALL DELAY_250MS
003F,E5 20,,        MOV A,20H
0041,23,,        RL A
0042,F5 20,,        MOV 20H,A
0044,80 F3,,        SJMP MAIN_LOOP
,,,
0046,,DELAY_250MS,DELAY_250MS:
0046,7E FA,,        MOV R6, #250        ; 外层循环次数 (100次)
0048,,DELAY_LOOP1,DELAY_LOOP1:
0048,7F F8,,        MOV R7, #248        ; 内层循环次数 (248次)
004A,,DELAY_LOOP2,DELAY_LOOP2:
004A,DF FE,,        DJNZ R7, DELAY_LOOP2 ; 2周期 × 248次 = 496μs
004C,DE FA,,        DJNZ R6, DELAY_LOOP1 ; 外层循环控制
004E,22,,                RET
000E,,,END
