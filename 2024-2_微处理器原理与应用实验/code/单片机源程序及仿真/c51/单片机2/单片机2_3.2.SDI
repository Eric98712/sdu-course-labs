,,,ORG 0000H
0000,01 30,,AJMP MAIN
,,,ORG 0030H
,,,
0030,,MAIN,MAIN:
0030,75 81 60,,    MOV SP, #60H        ; 设置堆栈指针
,,,
0033,,MAIN_LOOP,MAIN_LOOP:
,,,    ; 第一部分输出
0033,90 FE 00,,    MOV DPTR, #0FE00H   ; 外部地址FE00H
0036,74 F3,,    MOV A, #0F3H
0038,F0,,    MOVX @DPTR, A       ; 使用MOVX写入外部存储器
,,,
0039,90 FD 00,,    MOV DPTR, #0FD00H   ; 外部地址FD00H
003C,74 0C,,    MOV A, #0CH
003E,F0,,    MOVX @DPTR, A
,,,
003F,7C 0A,,    MOV R4, #0AH        ; 循环10次，使用立即数
0041,,LOOP_DELAY1,LOOP_DELAY1:
0041,12 00 81,,    LCALL DELAY_1S
0044,DC FB,,    DJNZ R4, LOOP_DELAY1
,,,
,,,    ; 第二部分输出
0046,90 FE 00,,    MOV DPTR, #0FE00H
0049,74 C3,,    MOV A, #0C3H
004B,F0,,    MOVX @DPTR, A
,,,
004C,90 FD 00,,    MOV DPTR, #0FD00H
004F,74 0F,,    MOV A, #0FH
0051,F0,,    MOVX @DPTR, A
,,,
0052,7C 02,,    MOV R4, #02H        ; 循环2次
0054,,LOOP_DELAY2,LOOP_DELAY2:
0054,12 00 81,,    LCALL DELAY_1S
0057,DC FB,,    DJNZ R4, LOOP_DELAY2
,,,
,,,    ; 第三部分输出
0059,90 FE 00,,    MOV DPTR, #0FE00H
005C,74 FC,,    MOV A, #0FCH
005E,F0,,    MOVX @DPTR, A
,,,
005F,90 FD 00,,    MOV DPTR, #0FD00H
0062,74 03,,    MOV A, #03H
0064,F0,,    MOVX @DPTR, A
,,,
0065,7C 0A,,    MOV R4, #0AH        ; 循环10次
0067,,LOOP_DELAY3,LOOP_DELAY3:
0067,12 00 81,,    LCALL DELAY_1S
006A,DC FB,,    DJNZ R4, LOOP_DELAY3
,,,
,,,    ; 第四部分输出
006C,90 FE 00,,    MOV DPTR, #0FE00H
006F,74 3C,,    MOV A, #03CH
0071,F0,,    MOVX @DPTR, A
,,,
0072,90 FD 00,,    MOV DPTR, #0FD00H
0075,74 0F,,    MOV A, #0FH
0077,F0,,    MOVX @DPTR, A
,,,
0078,7C 02,,    MOV R4, #02H        ; 循环2次
007A,,LOOP_DELAY4,LOOP_DELAY4:
007A,12 00 81,,    LCALL DELAY_1S
007D,DC FB,,    DJNZ R4, LOOP_DELAY4
,,,
007F,01 33,,    AJMP MAIN_LOOP      ; 返回主循环
,,,
,,,; 延时约1秒的子程序（基于12MHz晶振）
0081,,DELAY_1S,DELAY_1S:
0081,7D 0A,,    MOV R5, #10         ; 外层循环10次
0083,,DELAY_OUTER,DELAY_OUTER:
0083,7E C8,,    MOV R6, #200        ; 中层循环200次
0085,,DELAY_MID,DELAY_MID:
0085,7F F8,,    MOV R7, #248        ; 内层循环248次
0087,,DELAY_INNER,DELAY_INNER:
0087,DF FE,,    DJNZ R7, DELAY_INNER ; 248×2 = 496周期
0089,DE FA,,    DJNZ R6, DELAY_MID  ; 200×498周期
008B,DD F6,,    DJNZ R5, DELAY_OUTER ; 10×99600 = 996000周期（约0.996秒）
008D,22,,    RET
,,,
000E,,,END
