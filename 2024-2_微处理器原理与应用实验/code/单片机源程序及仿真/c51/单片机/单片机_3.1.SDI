,,,ORG 0000H
0000,01 30,,AJMP MAIN
,,,ORG 0030H
0030,,MAIN,MAIN:
0030,75 81 60,,        MOV SP,#60H
0033,75 80 FF,,        MOV P0,#0FFH
0036,75 20 FE,,        MOV 20H,#0FEH
,,,
0039,,MAIN_LOOP,MAIN_LOOP:
0039,30 90 05,,        JNB P1.0, LED_RR
003C,30 91 0F,,        JNB P1.1, LED_RL
003F,80 F8,,        SJMP MAIN_LOOP
0041,,LED_RR,LED_RR:
0041,85 20 80,,        MOV P0,20H
0044,12 00 5B,,        LCALL DELAY_100MS
0047,E5 20,,        MOV A,20H
0049,03,,        RR A
004A,F5 20,,        MOV 20H,A
004C,80 EB,,        SJMP MAIN_LOOP
004E,,LED_RL,LED_RL:
004E,85 20 80,,        MOV P0,20H
0051,12 00 5B,,        LCALL DELAY_100MS
0054,E5 20,,        MOV A,20H
0056,23,,        RL A
0057,F5 20,,        MOV 20H,A
0059,80 DE,,        SJMP MAIN_LOOP
,,,
005B,,DELAY_100MS,DELAY_100MS:
005B,7E 64,,        MOV R6, #100        ; 外层循环次数 (100次)
005D,,DELAY_LOOP1,DELAY_LOOP1:
005D,7F F8,,        MOV R7, #248        ; 内层循环次数 (248次)
005F,,DELAY_LOOP2,DELAY_LOOP2:
005F,DF FE,,        DJNZ R7, DELAY_LOOP2 ; 2周期 × 248次 = 496μs
0061,DE FA,,        DJNZ R6, DELAY_LOOP1 ; 外层循环控制
0063,22,,                RET
000E,,,END
