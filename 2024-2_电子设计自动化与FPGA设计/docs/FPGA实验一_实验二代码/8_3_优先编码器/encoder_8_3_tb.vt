    #20;
    A7=0;A6=0;A5=0;A4=1;A3=0;A2=0; A1=0; A0=0;
    #20;
    A7=0;A6=0;A5=1;A4=0;A3=0;A2=0; A1=0; A0=0;
    #20;
    A7=0;A6=1;A5=0;A4=0;A3=0;A2=0; A1=0; A0=0;
