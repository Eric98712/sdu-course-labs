`timescale 1ns / 1ns

module add_16_tb();
    reg [15:0]A0;
    reg [15:0]A1;
    reg CO_p;
	 
    wire [15:0]SO;
    wire CO; 
	 
    adder_16_bcd add_16_bainst0 (
    .A0(A0),
    .A1(A1),
    .SO(SO),
    .CO(CO),
    .CI(CO_p)
  );
  
 initial begin
    	#20
    	A0 = 16'b1001_1001_1001_1001;A1 = 16'b0000_0000_0000_0001;CO_p = 0;
    	#20
    	A0 = 16'b1001_1001_1001_1001;A1 = 16'b0000_0000_0000_0010;CO_p = 0;
	#20
    	A0 = 16'b0000_0000_0000_0001;A1 = 16'b0000_0000_0000_0011;CO_p = 0;
    	#20
    	A0 = 16'b0000_0000_0000_0001;A1 = 16'b0000_0000_0000_0010;CO_p = 0;
	#20
    	A0 = 16'b0000_0000_0000_0001;A1 = 16'b0000_0000_0000_0010;CO_p = 1;
  end



endmodule